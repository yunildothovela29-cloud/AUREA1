{
  "collections": [
    {
      "name": "properties",
      "path": "properties/{propertyId}",
      "description": "Store property listings.",
      "securityRules": {
        "read": "true",
        "create": "isAdmin()",
        "update": "isAdmin()",
        "delete": "isAdmin()"
      },
      "fields": [
        { "name": "title", "type": "string" },
        { "name": "slug", "type": "string" },
        { "name": "operation", "type": "string" },
        { "name": "type", "type": "string" },
        { "name": "location", "type": "string" },
        { "name": "neighborhood", "type": "string" },
        { "name": "city", "type": "string" },
        { "name": "price", "type": "number" },
        { "name": "priceDisplay", "type": "string" },
        { "name": "currency", "type": "string" },
        { "name": "bedrooms", "type": "number" },
        { "name": "bathrooms", "type": "number" },
        { "name": "area", "type": "number" },
        { "name": "parking", "type": "number", "optional": true },
        { "name": "yearBuilt", "type": "number", "optional": true },
        { "name": "featured", "type": "boolean" },
        { "name": "tag", "type": "string", "optional": true },
        { "name": "description", "type": "string" },
        { "name": "longDescription", "type": "string[]" },
        { "name": "highlights", "type": "string[]" },
        { "name": "amenities", "type": "string[]" },
        { "name": "images", "type": "string[]" },
        { "name": "status", "type": "string" },
        { "name": "createdAt", "type": "timestamp" },
        { "name": "updatedAt", "type": "timestamp" }
      ]
    },
    {
      "name": "users",
      "path": "users/{userId}",
      "description": "User profiles and roles.",
      "securityRules": {
        "read": "request.auth.uid == userId || isAdmin()",
        "create": "false",
        "update": "isAdmin()",
        "delete": "isAdmin()"
      },
      "fields": [
        { "name": "email", "type": "string" },
        { "name": "role", "type": "string" }
      ]
    },
    {
      "name": "visits",
      "path": "visits/{visitId}",
      "description": "Visit requests from clients.",
      "securityRules": {
        "read": "isAdmin()",
        "create": "true",
        "update": "isAdmin()",
        "delete": "isAdmin()"
      },
      "fields": [
        { "name": "propertyId", "type": "string" },
        { "name": "propertyTitle", "type": "string" },
        { "name": "clientName", "type": "string" },
        { "name": "clientEmail", "type": "string" },
        { "name": "clientPhone", "type": "string" },
        { "name": "preferredDate", "type": "string" },
        { "name": "message", "type": "string", "optional": true },
        { "name": "status", "type": "string" },
        { "name": "createdAt", "type": "timestamp" }
      ]
    }
  ],
  "customFunctions": [
    {
      "name": "isAdmin",
      "body": "return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';"
    }
  ]
}
